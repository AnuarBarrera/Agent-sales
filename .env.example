# Tu Web MX CRM - Environment Variables

# App
APP_NAME="Tu Web MX CRM"
ENVIRONMENT=development
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/tuwebmx_crm
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6380/0

# Security
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# RQ
RQ_QUEUE_NAME=default
RQ_JOB_TIMEOUT_SECONDS=1800

# File storage (MinIO for development)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tuwebmx-crm
STORAGE_REGION=us-east-1

# External providers
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
META_ACCESS_TOKEN=
OPENAI_API_KEY=
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Frontend map
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_API_PROXY_TARGET=http://localhost:8000
